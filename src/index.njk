<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-4VQGFJQWZL"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-4VQGFJQWZL');
</script>

<!-- ===================== SEO: BASICS ===================== -->
<title>Perth Beers — Discover WA's Best Craft Breweries & Local Drops</title>
<meta name="description" content="Perth is brewing something special. Discover the local craft breweries, the brewers behind the beer, and the drops you need in your glass — all in one place.">
<meta name="keywords" content="Perth craft beer, WA breweries, Swan Valley brewery trail, Fremantle breweries, Western Australia craft beer guide, Perth tap rooms">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://www.perthbeers.au/">
<meta name="theme-color" content="#0D0D0D">

<!-- ===================== SEO: OPEN GRAPH (Facebook / LinkedIn) ===================== -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.perthbeers.au/">
<meta property="og:title" content="Perth Beers — Discover WA's Best Craft Breweries & Local Drops">
<meta property="og:description" content="Perth is brewing something special. Discover the local craft breweries, the brewers behind the beer, and the drops you need in your glass — all in one place.">
<meta property="og:image" content="https://www.perthbeers.au/assets/perth-beers-logo.png">
<meta property="og:image:alt" content="Perth Beers logo — Western Australia craft beer guide">
<meta property="og:site_name" content="Perth Beers">
<meta property="og:locale" content="en_AU">

<!-- ===================== SEO: TWITTER / X CARD ===================== -->
<meta name="twitter:card" content="summary">
<meta name="twitter:url" content="https://www.perthbeers.au/">
<meta name="twitter:title" content="Perth Beers — Discover WA's Best Craft Breweries & Local Drops">
<meta name="twitter:description" content="Perth is brewing something special. Discover the local craft breweries, the brewers behind the beer, and the drops you need in your glass — all in one place.">
<meta name="twitter:image" content="https://www.perthbeers.au/assets/perth-beers-logo.png">
<meta name="twitter:image:alt" content="Perth Beers logo — Western Australia craft beer guide">

<!-- ===================== SEO: STRUCTURED DATA (Google Rich Results) ===================== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.perthbeers.au/#website",
      "url": "https://www.perthbeers.au/",
      "name": "Perth Beers",
      "description": "Perth is brewing something special. Discover the local craft breweries, the brewers behind the beer, and the drops you need in your glass — all in one place.",
      "inLanguage": "en-AU",
      "publisher": {
        "@id": "https://www.perthbeers.au/#organization"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://www.perthbeers.au/#organization",
      "name": "Perth Beers",
      "url": "https://www.perthbeers.au/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.perthbeers.au/assets/perth-beers-logo.png",
        "width": 300,
        "height": 333
      },
      "sameAs": []
    }
  ]
}
</script>

<!-- ===================== FAVICON ===================== -->
<!-- Brand logo, cropped to a square. Real files (not inline data URIs) — Google's
     favicon crawler needs a stable, separately-fetchable URL to reliably show
     an icon in search results. -->
<link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png">
<link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="shortcut icon" href="/favicon.ico">

<!-- General Sans + Excon are Fontshare fonts, not Google Fonts — served from Fontshare's own CDN -->
<link rel="preconnect" href="https://api.fontshare.com">
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&f[]=excon@400,500,600,700&display=swap" rel="stylesheet">

<!-- "The Pour" design stylesheet -->
<link rel="stylesheet" href="css/site.css">
</head>

<body>

<!-- signature: the scroll pour -->
<div class="pour" aria-hidden="true">
  <div class="glass">
    <div class="liquid" id="liquid">
      <div class="foam"></div>
      <div class="bubbles"><span></span><span></span><span></span></div>
    </div>
  </div>
  <div class="pct" id="pct">0%</div>
</div>

<div class="dot" id="dot"></div>

<nav>
  <a class="brand" href="#home" aria-label="Perth Beers — home"><img src="assets/perth-beers-logo.png" alt="Perth Beers"></a>
  <div class="links">
    <a href="#beers" data-hover>Local Breweries</a>
    <a href="#trail" data-hover>The Trail</a>
  </div>
  <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobilePanel">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-panel" id="mobilePanel">
  <a href="#home">Home</a>
  <a href="#beers">Local Breweries</a>
  <a href="#trail">The Trail</a>
</div>

<!-- ===================== HERO ===================== -->
<header class="hero" id="home">
  <div class="sun" aria-hidden="true"></div>
  <p class="eyebrow">Western Australia · Craft Beer Guide</p>
  <h1>
    <span class="row"><span>Good Vibes,</span></span>
    <span class="row"><span>Great Weather &</span></span>
    <span class="row"><span>World-Class Brews</span></span>
  </h1>
  <p class="sub">Perth is brewing something special. Discover the local craft breweries, the brewers behind the beer, and the drops you need in your glass — all in one place.</p>
  <div class="cta">
    <a href="#beers" data-hover>Explore Local Breweries →</a>
  </div>
  <p class="scroll-cue">Scroll to pour</p>
</header>

<!-- ===================== TICKER ===================== -->
<div class="ticker" aria-hidden="true">
  <div class="track" id="tick">
{%- for beer in beers.items %}
    <span>{{ beer.name }}</span>
{%- endfor %}
  </div>
</div>

<!-- ===================== BEERS ===================== -->
<section class="block light" id="beers">
  <div class="section-head reveal">
    <p class="kicker">On Tap Across Perth</p>
    <h2>What's Actually<br>In The Glass</h2>
    <p>Pours worth crossing town for, pulled from breweries across the four patches. Tap through, then go find the real thing.</p>
  </div>

  <div class="filters reveal" role="group" aria-label="Filter beers by region">
    <button class="on" data-f="all" data-hover>All patches</button>
    <button data-f="fremantle" data-hover>Fremantle</button>
    <button data-f="southperth" data-hover>South Perth</button>
    <button data-f="swanvalley" data-hover>Swan Valley</button>
    <button data-f="innercity" data-hover>Inner City</button>
    <button data-f="coastal" data-hover>Coastal North</button>
  </div>

  <div class="beer-grid" id="grid">
{%- set regionLabels = { "fremantle": "Fremantle", "southperth": "South Perth", "swanvalley": "Swan Valley", "innercity": "Inner City", "coastal": "Coastal North" } %}
{%- for beer in beers.items %}
    <a class="beer" data-r="{{ beer.region }}" data-hover href="{{ beer.link }}" target="_blank" rel="noopener noreferrer">
      <span class="rg {{ beer.region }}">{{ regionLabels[beer.region] }}</span>
      <h3>{{ beer.brewery }}</h3>
      <p class="brew">{{ beer.name }}</p>
      <span class="style">{{ beer.type }}</span>
      <div class="go"><span>Visit brewery</span><span class="arrow">→</span></div>
    </a>
{%- endfor %}
  </div>
</section>

<!-- ===================== TRAIL ===================== -->
<section class="block" id="trail">
  <div class="section-head reveal">
    <p class="kicker">Find a Brew</p>
    <h2>The Ultimate Swan Valley<br>Brewery Trail</h2>
    <p>Just 25 minutes north-east of the Perth CBD, the Swan Valley is famous for its vineyards — but it's also home to one of Australia's densest corridors of independent craft breweries. The route draws itself as you scroll.</p>
  </div>

  <div class="trail-stats reveal">
    <div>Full Day Trip</div><div>~30km Loop</div><div>Beer Lovers, Families &amp; Weekend Road-Trippers</div>
  </div>

  <div class="trail-wrap">
    <div class="stops" id="stops">
{%- for stop in trail.items %}
      <div class="stop" data-stop="{{ loop.index }}">
        <span class="n">{{ loop.index }}</span>
        <h3>{{ stop.name }}</h3>
        <p class="pl">{{ stop.place }}</p>
        <p>{{ stop.bestFor }}</p>
      </div>
{%- endfor %}
    </div>

    <div class="trail-map">
      <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Stylised Swan Valley trail map with five brewery stops">
        <text class="region-mark" x="30" y="60">Swan</text>
        <text class="region-mark" x="30" y="92">Valley</text>
        <path d="M-20,40 C40,90 30,160 90,210 C150,260 140,340 200,390 C250,430 280,470 260,520" fill="none" stroke="#F5F0E6" stroke-opacity="0.10" stroke-width="12" stroke-linecap="round"/>
        <text class="lbl" x="26" y="228" transform="rotate(48 26 228)">Swan River</text>
        <path class="route-ghost" d="M70,460 C85,430 95,415 110,390 C130,365 165,335 180,310 C198,288 215,282 230,270 C248,238 258,200 270,170 C280,150 290,130 300,110"/>
        <path class="route" id="route" d="M70,460 C85,430 95,415 110,390 C130,365 165,335 180,310 C198,288 215,282 230,270 C248,238 258,200 270,170 C280,150 290,130 300,110"/>
        <circle cx="70" cy="460" r="5" fill="none" stroke="#F5F0E6" stroke-opacity=".55" stroke-width="2"/>
        <text class="lbl" x="84" y="464">Perth · 25 min</text>
{%- set coords = [[110,390],[180,310],[230,270],[270,170],[300,110]] %}
{%- for stop in trail.items %}
        <g class="pin" data-pin="{{ loop.index }}" data-name="{{ stop.name }}" data-place="{{ stop.place }}" transform="translate({{ coords[loop.index0][0] }},{{ coords[loop.index0][1] }})">
          <circle class="halo" r="9" fill="rgba({% if loop.last %}232,163,61{% else %}228,34,61{% endif %},.4)"/>
          <circle class="core" r="14"/>
          <text text-anchor="middle" dy="4.5">{{ loop.index }}</text>
        </g>
{%- endfor %}
      </svg>
      <div class="map-tip" id="mapTip">
        <p class="t-num" id="tipNum"></p>
        <p class="t-name" id="tipName"></p>
        <p class="t-place" id="tipPlace"></p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== INSTAGRAM ===================== -->
<section class="insta" id="instagram">
  <div class="insta-ring" aria-hidden="true"></div>
  <div class="insta-inner">
    <p class="insta-kicker reveal">Follow the Pour</p>
    <h2 class="insta-handle reveal">@theperthbeers</h2>
    <p class="insta-sub reveal">New pours, brewery news and trail tips from across WA's craft beer scene. Follow along so you never miss a good one.</p>

    <a class="insta-btn reveal" data-hover href="https://www.instagram.com/theperthbeers" target="_blank" rel="noopener noreferrer" onclick="window.gtag && gtag('event', 'instagram_follow_click');">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      Follow on Instagram
    </a>

    <ul class="insta-points reveal">
      <li>Fresh pours</li>
      <li>Brewery news</li>
      <li>Beer trails</li>
    </ul>
  </div>
</section>

<!-- ===================== FINALE ===================== -->
<section class="finale" id="visit">
  <div class="sun2" aria-hidden="true"></div>
  <h2 class="reveal">Show Up<br><em>Thirsty</em></h2>
  <p class="reveal">Your independent guide to Western Australia's craft beer scene.</p>
</section>

<footer>
  <span>© 2026 Perth Beers. Independent guide, not affiliated with any brewery listed.</span>
  <span><a class="foot-link" href="https://www.instagram.com/theperthbeers" target="_blank" rel="noopener noreferrer">Instagram</a> · Enjoy WA's craft beer scene responsibly</span>
</footer>

<script src="js/main.js"></script>
</body>
</html>
