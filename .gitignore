# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
*.swp

# Node dependencies (installed fresh by `npm install`, never committed)
node_modules/

# Eleventy build output (generated by the build — Netlify rebuilds it, so we don't commit it)
_site/

# Never commit credentials
*credentials*
*secrets*
.env
.env.*
ftp-config.*
